{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver",
    "helpers:githubDigestChangelogs"
  ],
  "enabledManagers": [
    "github-actions",
    "custom.regex"
  ],
  "prHourlyLimit": 0,
  "minimumReleaseAge": "2 days",
  "internalChecksFilter": "strict",
  "vulnerabilityAlerts": {
    "enabled": true,
    "commitMessageSuffix": ""
  },
  "labels": ["kind/dependencies", "bot"],
  "semanticCommits": "disabled",
  "commitMessagePrefix": "deps{{#if isVulnerabilityAlert}}(security){{/if}}:",
  // Add new runner releases while retaining the previous compatibility target.
  // Retired images must still be removed from the matrix manually.
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yml$/"],
      "matchStrings": [
        "(?<indentation>[ \\t]*)-[ \\t]+(?<depName>ubuntu|macos|windows|xcode)-(?<currentValue>[0-9][a-zA-Z0-9.-]*)[ \\t]+# renovate: runner"
      ],
      "datasourceTemplate": "github-runners",
      "versioningTemplate": "docker",
      "autoReplaceStringTemplate": "{{{indentation}}}- {{{depName}}}-{{{newValue}}} # renovate: runner\n{{{indentation}}}- {{{depName}}}-{{{currentValue}}}"
    }
  ],
  "packageRules": [
    {
      "matchFileNames": [".github/workflows/**", "action.yml"],
      "commitMessagePrefix": "deps(ci{{#if isVulnerabilityAlert}},security{{/if}}):"
    },
    {
      "matchUpdateTypes": ["major", "minor", "patch"],
      "commitMessageAction": "bump",
      "commitMessageTopic": "{{{depName}}}",
      "commitMessageExtra": "from {{{replace '^v' '' currentValue}}} to {{{replace '^v' '' newValue}}}"
    }
  ]
}
